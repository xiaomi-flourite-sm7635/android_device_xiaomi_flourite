# SPDX-License-Identifier: Apache-2.0
typeattribute flourite_parts_app coredomain;
typeattribute flourite_parts_app mlstrustedsubject;
app_domain(flourite_parts_app)

allow flourite_parts_app {
    activity_service
    activity_task_service
    audio_service
    autofill_service
    batteryproperties_service
    batterystats_service
    clipboard_service
    legacy_permission_service
    media_session_service
    sensitive_content_protection_service
    thermal_service
    uimode_service
    vibrator_manager_service
}:service_manager find;
allow flourite_parts_app system_app_data_file:dir create_dir_perms;
allow flourite_parts_app system_app_data_file:{ file lnk_file } create_file_perms;
r_dir_file(flourite_parts_app, sysfs_zram)
r_dir_file(flourite_parts_app, sysfs_devices_system_cpu)

# Only init passes the saved ZRAM choice to vendor at the next boot.
system_internal_prop(flouriteparts_zram_request_prop)
set_prop(flourite_parts_app, flouriteparts_zram_request_prop)
neverallow { domain -init -flourite_parts_app } flouriteparts_zram_request_prop:property_service set;
