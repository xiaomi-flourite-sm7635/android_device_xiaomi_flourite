cc_library_static {
    name: "power-ext-flourite",
    defaults: ["android.hardware.power-ndk_shared"],
    vendor: true,
    srcs: ["PowerMode.cpp"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
    ],
}
