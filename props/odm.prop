# Audio
persist.vendor.audio.spf_restart=true
ro.vendor.audio.aw.monitor=true
ro.vendor.audio.camera.loopback.support=false
ro.vendor.audio.crscallvolume.support=false
ro.vendor.audio.elus.enable=true
ro.vendor.audio.record.customized.support=true
ro.vendor.soundtrigger.dfs.support=1
vendor.audio.compress_capture.aac.cut_off_freq=24000
vendor.audio.cpu.sched.cpus=8
vendor.audio.cpu.sched.cpuset.af=248
vendor.audio.cpu.sched.cpuset.at=248
vendor.audio.cpu.sched.cpuset.hb=248
vendor.audio.cpu.sched.cpuset.he=248
vendor.audio.cpu.sched.cpuset.hso=248
vendor.audio.cpu.sched.onlyfast=false
vendor.audio.cpu.sched=31
vendor.audio.mic.status=off
vendor.audio.rt.mode.onlyfast=false
vendor.audio.rt.mode=19
vendor.audio.ultrasound.stoplatency=60
vendor.audio.ultrasound.usync=100

# Camera
ro.camerax.extensions.enabled=false
ro.camera.disableHeicUltraHDR=true

# DRM
vendor.wv.oemcrypto.debug.enable_prov40=true

# FW Detect
ro.vendor.qti.va_odm.support=1

# Graphics
debug.sf.set_idle_timer_ms=1100
persist.vendor.dc_backlight.enable=false
ro.surface_flinger.enable_frame_rate_override=false
ro.vendor.display.adaptive_hdr.enable=true
ro.vendor.display.adaptive_hdr2.enable=1
ro.vendor.display.ai_disp.enable=false
ro.vendor.display.bl_lut_calib.enable=true
ro.vendor.display.darkmode_dither.enable=true
ro.vendor.display.dobly_dpu.enable=false
ro.vendor.display.dolbyvision.support=true
ro.vendor.display.enable_unlock_insert_black_frame=true
ro.vendor.display.fod_monitor_default_fps=120
ro.vendor.display.idle_default_fps=60
ro.vendor.display.kernel_recoder_enable=false
ro.vendor.display.mi_calib.enable=true
ro.vendor.display.mode_change_optimize.enable=true
ro.vendor.display.nature_mode.enable=false
ro.vendor.display.set_fps_stat_timer_ms=250
ro.vendor.display.skip_idle_for_90hz=true
ro.vendor.display.standard_d75_enable=true
ro.vendor.display.touch.idle.enable=true
ro.vendor.display.type=oled
ro.vendor.display.update_dbi_by_temperature=true
ro.vendor.display.video_or_camera_fps.support=true
ro.vendor.histogram.enable=true
ro.vendor.localhbm.enable=true
ro.vendor.sre.enable=true
sys.displayfeature.entry.enable=true
vendor.display.boost_cpu_layer_number_threshold=10
vendor.display.disable_3d_adaptive_tm=1
vendor.display.disable_cwb_call=0
vendor.display.disable_cwb_idle_fallback=1
vendor.display.disable_llcc_during_aod=1
vendor.display.disable_sdr_dimming=0
vendor.display.disable_stc_dimming=1
vendor.display.force_tonemapping=1
vendor.display.idle_time=80
vendor.display.multi_display_boost_cpu=1
vendor.display.support_function_timer=1
vendor.display.support_video_mode_30hz_aod=1
vendor.display.use_layer_ext=0

# Fingerprint
ro.hardware.fp.fod=true
ro.hardware.fp.tddi=true
persist.vendor.sys.fp.expolevel=0x88
persist.vendor.sys.fp.fod.location.X_Y=534,2413
persist.vendor.sys.fp.fod.size.width_height=210,210
ro.hardware.fp.fod.location=low
ro.hardware.fp.fod.touch.ctl.version=2.0
ro.hardware.fp.fod.lowlight.lux.threshold=3
ro.hardware.fp.fod.lowlight.brightness.threshold=411
ro.hardware.fp.mievent=true
ro.hardware.fp.onetrack.period=3600000

# Media
ro.odm.build.media_performance_class=0
ro.vendor.media_performance_class=0

# Radio
ro.telephony.default_network=33,33

# SKU
ro.product.property_source_order=odm,vendor,product,system_ext,system
import /odm/etc/${ro.boot.product.hardware.sku}_build.prop
import /odm/etc/${ro.boot.product.hardware.sku}_${ro.boot.ptcountrycode}_build.prop
import /odm/etc/${ro.boot.product.hardware.sku}_${ro.boot.hwversion}.prop

# NFC / secure element
ro.vendor.se.type=HCE,UICC
ro.vendor.nfc.repair=1
ro.vendor.nfc.dispatch_optim=2
ro.vendor.nfc.disable.i2c=false
ro.vendor.se.info=19-1010212
ro.vendor.se.chip.model=SN220T
ro.vendor.nfc.wallet_fusion=1
ro.vendor.nfc.debounce_field_on=1
ro.vendor.nfc.field_on_debounce=800
nfc.fw.is_downloading=false

# SSR
persist.vendor.ssr.restart_level=ALL_ENABLE

# Sensors
ro.vendor.sensor.maxbrightness=10926
persist.vendor.sensor.mischeck=true
persist.vendor.debug.collision.dfx=true

# Thermal
persist.vendor.tracking.dfs=true
