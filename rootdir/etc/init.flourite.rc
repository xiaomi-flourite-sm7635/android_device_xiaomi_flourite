# Device-specific additions for the source-built Lineage services. Qualcomm
# and Xiaomi platform setup remains in the stock-derived init.qcom.rc and
# init.target.rc files.

on boot
    # Userdebug starts AOSP's serial shell by default. Keep ADB available, but
    # do not expose a console on the device UART.
    stop console

    # Lineage's sensor notifier watches these nodes to bridge Xiaomi's
    # non-UI and AOD sensors into the display/touch drivers.
    chown system system /dev/mi_display/disp_feature
    chmod 0660 /dev/mi_display/disp_feature
    chown system system /dev/xiaomi-touch
    chmod 0660 /dev/xiaomi-touch
    chown system system /sys/class/touch/touch_dev/fod_longpress_gesture_enabled
    chmod 0660 /sys/class/touch/touch_dev/fod_longpress_gesture_enabled
    chown system system /sys/class/touch/touch_dev/gesture_single_tap_enabled
    chmod 0660 /sys/class/touch/touch_dev/gesture_single_tap_enabled
    chown system system /sys/class/touch/touch_dev/gesture_double_tap_enabled
    chmod 0660 /sys/class/touch/touch_dev/gesture_double_tap_enabled

    # The source-built fingerprint service runs as system and loads the
    # proprietary Goodix/Jiiov legacy HAL directly.
    chown system system /dev/goodix_fp
    chmod 0660 /dev/goodix_fp
    chown system system /dev/xiaomi-fp
    chmod 0660 /dev/xiaomi-fp
    chown system system /dev/mifp_id
    chmod 0660 /dev/mifp_id
    chown system system /sys/bus/platform/devices/soc:xiaomi_fingerprint/fingerdown
    chmod 0660 /sys/bus/platform/devices/soc:xiaomi_fingerprint/fingerdown
    chown system system /sys/bus/platform/devices/soc:xiaomi_fingerprint/intr2
    chmod 0660 /sys/bus/platform/devices/soc:xiaomi_fingerprint/intr2

on post-fs-data
    mkdir /data/vendor/misc/mi_fp 0770 system system
    mkdir /data/vendor/fpc 0770 system system
    mkdir /data/vendor/fpdump 0770 system system
    mkdir /data/vendor/fpdump/qfs4008 0770 system system
    mkdir /data/vendor/goodix 0770 system system
    mkdir /data/vendor/fpdata 0770 system system
    mkdir /data/vendor/fingerprint 0770 system system
    mkdir /persist/mi_fp 0770 system system
    mkdir /mnt/vendor/persist/mi_fp 0770 system system
    mkdir /mnt/vendor/persist/goodix 0770 system system
    mkdir /mnt/vendor/persist/fpc 0770 system system
    mkdir /mnt/vendor/persist/fingerprint 0770 system system
    mkdir /mnt/vendor/persist/fingerprint/jiiov 0770 system system


# The qcom-battery class is registered by a late-loaded kernel module, after
# the boot action has already run. Grant Lineage Health access once Android
# has completed booting; its HAL uses an explicit node and can register before
# the node becomes writable.
on property:sys.boot_completed=1
    chown system system /sys/class/qcom-battery/input_suspend
    chmod 0660 /sys/class/qcom-battery/input_suspend
    chown system system /sys/class/qcom-battery/fastcharge_enable
    chmod 0660 /sys/class/qcom-battery/fastcharge_enable

# The second endpoint is consumed by sensors.ultrasoundproximity.so.
service vendor.sensors-hal-multihal /vendor/bin/hw/android.hardware.sensors-service.xiaomi-multihal
    override
    class hal
    user system
    group system wakelock context_hub input uhid
    task_profiles ServiceCapacityLow
    socket audio_us_socket_1 seqpacket 0666 system system
    capabilities BLOCK_SUSPEND
    rlimit rtprio 10 10
