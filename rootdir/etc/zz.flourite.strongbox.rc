# Keep the source-built NXP StrongBox service in its dedicated SELinux domain.
# The stock service also runs with the NXP group and WAKE_ALARM capability.
service vendor.keymint-strongbox /vendor/bin/hw/android.hardware.security.keymint3-service.strongbox.nxp
    override
    class early_hal
    user vendor_nxp_strongbox
    group vendor_nxp_strongbox
    capabilities WAKE_ALARM
    seclabel u:r:vendor_hal_keymint_strongbox:s0
