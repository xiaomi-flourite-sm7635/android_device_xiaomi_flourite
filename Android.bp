soong_namespace {
    imports: [
        "hardware/google/interfaces",
        "hardware/google/pixel",
        "hardware/qcom-caf/common/libqti-perfd-client",
        "hardware/xiaomi",
    ],
}

prebuilt_etc_xml {
    name: "manifest_flourite_audio.xml",
    src: "configs/hidl/manifest_non_qmaa.xml",
    filename: "manifest_flourite_audio.xml",
    sub_dir: "vintf/manifest",
    soc_specific: true,
}

// Compile-time guard for the pinned camera allocation fixups.
cc_library_static {
    name: "flourite_camera_abi_check",
    vendor: true,
    compile_multilib: "64",
    srcs: ["camera/graphicbuffer_abi_check.cpp"],
    shared_libs: ["libui"],
    cflags: ["-Wall", "-Werror"],
}

cc_library_shared {
    name: "libflourite_camera_metadata",
    vendor: true,
    compile_multilib: "64",
    srcs: ["camera/raw_metadata.cpp"],
    header_libs: ["libcutils_headers"],
    static_libs: ["flourite_camera_abi_check"],
    shared_libs: [
        "//vendor/xiaomi/flourite:libcom.xiaomi.metadatautils",
        "libcamera_metadata",
        "libdl",
        "liblog",
    ],
    cpp_std: "c++17",
    cflags: ["-Wall", "-Wextra", "-Werror", "-fvisibility=hidden"],
}

install_symlink {
    name: "firmware_wlanmdsp.otaupdate_symlink",
    vendor: true,
    installed_location: "firmware/wlanmdsp.otaupdate",
    symlink_target: "/data/vendor/firmware/wlanmdsp.mbn",
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6750/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/wlan/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6750/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/qca6750/WCNSS_qcom_cfg.ini",
}

install_symlink {
    name: "rfs_msm_mpss_readonly_mbnconfig_symlink",
    vendor: true,
    installed_location: "rfs/msm/mpss/readonly/mbnconfig",
    symlink_target: "/data/vendor/mbnconfig",
}
