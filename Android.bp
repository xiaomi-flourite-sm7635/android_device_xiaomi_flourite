soong_namespace {
    imports: [
        "hardware/google/interfaces",
        "hardware/google/pixel",
        "hardware/qcom-caf/common/libqti-perfd-client",
        "hardware/xiaomi",
    ],
}

cc_defaults {
    name: "flourite_first_stage_diag_defaults",
    srcs: ["diagnostics/first_stage_diag.c"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    static_executable: true,
    system_shared_libs: [],
    installable: false,
}

cc_binary {
    name: "flourite_first_stage_diag_bin",
    defaults: ["flourite_first_stage_diag_defaults"],
    ramdisk: true,
}

cc_binary {
    name: "flourite_first_stage_diag_recovery_bin",
    defaults: ["flourite_first_stage_diag_defaults"],
    recovery: true,
}

// first_stage_console executes this exact root path before first-stage mounts.
// A prebuilt_root wrapper is required because Soong only permits first-stage
// init itself to set install_in_root on a cc_binary.
prebuilt_root {
    name: "flourite_first_stage_diag",
    src: ":flourite_first_stage_diag_bin",
    filename: "first_stage.sh",
    ramdisk: true,
    install_in_root: true,
}

// vendor_boot carries the same bootconfig into recovery. Install the hook
// there as well so it can release init without opening a blocking console.
prebuilt_root {
    name: "flourite_first_stage_diag_recovery",
    src: ":flourite_first_stage_diag_recovery_bin",
    filename: "first_stage.sh",
    recovery: true,
    install_in_root: true,
}

install_symlink {
    name: "firmware_wlanmdsp.otaupdate_symlink",
    vendor: true,
    installed_location: "firmware/wlanmdsp.otaupdate",
    symlink_target: "/data/vendor/firmware/wlanmdsp.mbn",
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6750/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/wlan/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6750/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/qca6750/WCNSS_qcom_cfg.ini",
}
